# ==============================================================================
# Omni Platform - Environment Configuration Reference (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORE DATABASE & CACHING
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Multi-tenant relational data, RBAC, billing, CRM)
DATABASE_URL=postgres://omni:omni@localhost:5432/omni_platform

# Redis connection string (Pub/Sub, WebSocket scaling, BullMQ jobs, session cache)
REDIS_URL=redis://localhost:6379

# MongoDB (High-throughput conversational message archive & audit history)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=omni_platform
MONGODB_TIMEOUT_MS=5000

# Elasticsearch (Distributed full-text & fuzzy search across contacts and messages)
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & ENCRYPTION)
# ------------------------------------------------------------------------------
# JWT secret for signing and verifying tenant and platform user tokens
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# High-privilege platform staff (Super Admin, Developer, Tester) token lifetime
PLATFORM_JWT_EXPIRES_IN=1d

# AES-256-GCM encryption key for encrypting sensitive credentials at rest (32 bytes / 64 hex)
# If left empty, JWT_SECRET is used as fallback
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. META TECH PROVIDER & WHATSAPP EMBEDDED SIGNUP (PLATFORM APP)
# ------------------------------------------------------------------------------
# Meta App credentials from developers.facebook.com for 1-Click Embedded Signup
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0

# Default webhook verification token for Meta WhatsApp Cloud API webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# ------------------------------------------------------------------------------
# 5. AI ENGINE & KNOWLEDGE BASES (RAG)
# ------------------------------------------------------------------------------
# OpenAI API Key (Used for text-embedding-3-small vector embeddings & GPT-4o)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Anthropic API Key (Used for Claude 3.5 Sonnet AI Copilot & Auto-Pilot agents)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ------------------------------------------------------------------------------
# 6. BILLING & PAYMENT GATEWAYS (MULTI-GATEWAY CHECKOUT)
# ------------------------------------------------------------------------------
# Stripe Secret Key (For credit card, Apple Pay, SEPA subscriptions & payment links)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay Credentials (For UPI, Netbanking, Cards subscriptions & orders)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP FOR SUPPORT TICKETS & NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST blank or unconfigured to operate in simulated sandbox email mode
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM_EMAIL=support@omniplatform.io
SMTP_FROM_NAME="Omni Platform Support"

# ------------------------------------------------------------------------------
# 8. S3 OBJECT STORAGE (MEDIA ATTACHMENTS & ASSETS)
# ------------------------------------------------------------------------------
# Point MEDIA_S3_ENDPOINT at MinIO for local development; leave empty for AWS S3
MEDIA_BUCKET=omni-platform-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin

# ------------------------------------------------------------------------------
# 9. BACKGROUND AUTOMATION & CAMPAIGN SCHEDULER
# ------------------------------------------------------------------------------
# Polling interval in ms for due drip campaign steps and broadcast messages
DRIP_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 10. HOST & CORS URLS (OPTIONAL PLATFORM REFERENCE)
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:5173
