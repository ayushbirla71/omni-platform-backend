PORT=4000
DATABASE_URL=postgres://omni:omni@localhost:5432/omni_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WhatsApp BSP credentials go per-channel in the `channels.credentials` JSONB column,
# not here — these are only used for local webhook signature verification defaults.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# How often the drip-campaign poller checks for due steps (see src/index.ts).
DRIP_POLL_INTERVAL_MS=30000

# Meta Tech Provider credentials (Embedded Signup) — your platform's own
# Meta App, not per-tenant. See architecture doc §4a.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0

# MongoDB - message log storage (architecture doc §3)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=omni_platform

# Elasticsearch - full-text search across messages/contacts (architecture doc §3)
ELASTICSEARCH_URL=http://localhost:9200

# Object storage - media attachments (architecture doc §3). Point
# MEDIA_S3_ENDPOINT at MinIO (see docker-compose.yml) for local dev; leave
# unset in production to use real AWS S3 with the default credential chain.
MEDIA_BUCKET=omni-platform-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
